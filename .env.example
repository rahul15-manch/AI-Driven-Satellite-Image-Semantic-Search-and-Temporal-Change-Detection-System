# ==============================================================================
# Groq API Configuration for AI Model Explainability (Qwen 27B)
# ==============================================================================
# Copy this file to .env and replace with your verified Groq API key:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit your real .env file or API key to Git.
# - The .env file is automatically ignored by Git via .gitignore.
# ==============================================================================

GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=60
