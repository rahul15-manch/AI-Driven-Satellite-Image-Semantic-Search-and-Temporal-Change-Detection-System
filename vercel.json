{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1",
      "PYTHONPATH": ".",
      "UV_EXTRA_INDEX_URL": "https://download.pytorch.org/whl/cpu"
    }
  },
  "env": {
    "PYTHONPATH": "."
  },
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "src/**",
        "utils/**",
        "experiments/configs/**",
        "experiments/results/**",
        "experiments/figures/**",
        "frontend/**"
      ],
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/css/(.*)",
      "destination": "/frontend/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/frontend/js/$1"
    },
    {
      "source": "/vendor/(.*)",
      "destination": "/frontend/vendor/$1"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
