{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1",
      "PYTHONPATH": ".",
      "UV_EXTRA_INDEX_URL": "https://download.pytorch.org/whl/cpu"
    }
  },
  "env": {
    "PYTHONPATH": "."
  },
  "functions": {
    "api/index.py": {
      "includeFiles": "{experiments/**,data/demo_samples/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/index.py?path=:match*"
    }
  ]
}
